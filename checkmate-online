
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checkmate — Online Chess</title>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>

<style>
:root {
  --bg:#101813;
  --panel:#1a251e;
  --green:#75d69a;
  --text:#edf5ee;
  --muted:#a4b5a7;
  --danger:#ff7777;
}
* {box-sizing:border-box}
body {
  margin:0;
  min-height:100vh;
  background:radial-gradient(ellipse at top,#203729,var(--bg) 65%);
  color:var(--text);
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
}
button,input,select {font:inherit}
button {
  border:0;
  border-radius:10px;
  padding:12px 16px;
  cursor:pointer;
  font-weight:750;
}
button:hover {filter:brightness(1.1)}
button:disabled {opacity:.5;cursor:wait}
.primary {background:var(--green);color:#102318}
.secondary {background:#304437;color:var(--text)}
.danger {background:#733b3b;color:white}
.small {padding:8px 11px;font-size:13px}
header {
  max-width:1150px;
  margin:auto;
  padding:22px 20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
}
.brand {font-size:25px;font-weight:900;letter-spacing:-1px}
.brand span {color:var(--green)}
.subtitle {color:var(--muted);font-size:12px;margin-top:3px}
main {max-width:1150px;margin:auto;padding:0 20px 40px}
.panel {
  background:rgba(26,37,30,.97);
  border:1px solid #34483a;
  border-radius:18px;
  padding:22px;
  box-shadow:0 16px 45px #0002;
}
h1,h2,p {margin-top:0}
h1 {font-size:clamp(27px,4vw,38px);letter-spacing:-1px;margin-bottom:8px}
h2 {font-size:20px;margin-bottom:10px}
.muted {color:var(--muted)}
.smalltext {font-size:13px;line-height:1.5}
.field {display:flex;flex-direction:column;gap:7px;margin:15px 0}
.field label {font-size:13px;color:#c5d3c8;font-weight:750}
input,select {
  width:100%;
  background:#101913;
  border:1px solid #405345;
  color:var(--text);
  padding:12px;
  border-radius:10px;
  outline:none;
}
input:focus,select:focus {border-color:var(--green)}
.home-grid {display:grid;grid-template-columns:1fr 1fr;gap:18px}
.notice {margin-top:14px;color:var(--muted);font-size:13px;line-height:1.5;overflow-wrap:anywhere}
.error {color:var(--danger)}
.success {color:var(--green)}
.actions {display:flex;flex-wrap:wrap;gap:9px;margin-top:15px}
#gameScreen {display:none}
.game-layout {
  display:grid;
  grid-template-columns:minmax(0,1fr) 300px;
  gap:20px;
  align-items:start;
}
.board-wrap {width:100%;max-width:690px;margin:auto}
.playerbar {
  background:var(--panel);
  border:1px solid #34483a;
  border-radius:12px;
  padding:12px 14px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin:8px 0;
}
.player-name {font-weight:800;overflow-wrap:anywhere}
.player-color {font-size:12px;color:var(--muted);margin-top:3px}
.clock {
  font-size:23px;font-weight:900;font-variant-numeric:tabular-nums;
  background:#101913;border:1px solid #405345;border-radius:9px;
  padding:7px 11px;min-width:88px;text-align:center;
}
.clock.active {background:var(--green);color:#102318;border-color:var(--green)}
.clock.low {color:#ff8585}
#board {
  width:100%;aspect-ratio:1;display:grid;
  grid-template-columns:repeat(8,minmax(0,1fr));
  border:5px solid #34483a;border-radius:5px;overflow:hidden;
  user-select:none;
}
.square {
  position:relative;display:flex;justify-content:center;align-items:center;
  aspect-ratio:1;border-radius:0;padding:0;min-width:0;color:#172219;
}
.square.light {background:#e5eadc}
.square.dark {background:#63866b}
.square.selected {box-shadow:inset 0 0 0 5px #f5df60}
.square.lastmove::after {
  content:"";position:absolute;inset:0;background:#f5df603b;pointer-events:none;
}
.square.check {box-shadow:inset 0 0 0 5px #ef5d5d}
.piece {
  position:relative;z-index:1;font-family:"Segoe UI Symbol","DejaVu Sans",serif;
  font-size:clamp(24px,5.7vw,58px);line-height:1;pointer-events:none;
}
.piece.white {color:white;text-shadow:-1px -1px 1px #27352a,1px 1px 2px #27352a}
.piece.black {color:#1a241d;text-shadow:0 1px 1px #f2f2d7}
.legal-dot {
  position:absolute;width:25%;aspect-ratio:1;border-radius:50%;
  background:#18251d6b;z-index:2;pointer-events:none;
}
.capture-dot {
  position:absolute;inset:4%;border:4px solid #18251d7a;
  border-radius:50%;z-index:2;pointer-events:none;
}
.file-label,.rank-label {
  position:absolute;font-size:10px;font-weight:900;opacity:.8;
  z-index:3;pointer-events:none;
}
.file-label {right:4px;bottom:2px}
.rank-label {left:4px;top:2px}
.square.light .file-label,.square.light .rank-label {color:#41654a}
.square.dark .file-label,.square.dark .rank-label {color:#f2f4df}
.sidebar {display:flex;flex-direction:column;gap:14px}
.info-row {
  display:flex;justify-content:space-between;gap:10px;
  padding:9px 0;border-bottom:1px solid #34483a;font-size:13px;
}
.info-row:last-child {border-bottom:0}
.info-row span:first-child {color:var(--muted)}
#roomCode {font-weight:900;font-size:24px;letter-spacing:3px;color:var(--green);overflow-wrap:anywhere}
#moveList {
  max-height:210px;overflow:auto;
  font:13px/1.8 ui-monospace,Consolas,monospace;
  color:#d9e8db;white-space:pre-wrap;
}
#message {font-size:13px;line-height:1.5;margin-top:12px;overflow-wrap:anywhere}
#resultOverlay {
  display:none;position:fixed;inset:0;z-index:50;background:#07100bd9;
  align-items:center;justify-content:center;padding:20px;
}
.result-card {
  max-width:440px;width:100%;text-align:center;background:#1a2b20;
  border:1px solid #5a936c;border-radius:22px;padding:35px 25px;
  box-shadow:0 0 80px #60d98a26;animation:pop .35s ease;
}
.result-icon {font-size:48px;margin-bottom:12px}
.result-card h2 {font-size:30px}
@keyframes pop {
  from {transform:scale(.88);opacity:0}
  to {transform:scale(1);opacity:1}
}
@media(max-width:800px) {
  header {padding:17px 14px}
  main {padding:0 12px 28px}
  .home-grid,.game-layout {grid-template-columns:1fr}
  .panel {padding:16px}
  .board-wrap {max-width:620px}
}
</style>
</head>
<body>

<header>
  <div>
    <div class="brand">♞ Check<span>mate</span></div>
    <div class="subtitle">Online chess with friends</div>
  </div>
  <div id="connectionStatus" class="smalltext muted">Connecting…</div>
</header>

<main>
  <section id="homeScreen">
    <div class="panel" style="margin-bottom:18px">
      <h1>Make your next move.</h1>
      <p class="muted">Create a private room or join a friend with a room code.</p>
      <div class="field">
        <label for="username">Your display name</label>
        <input id="username" maxlength="20" placeholder="Enter a username" autocomplete="nickname">
      </div>
      <div id="homeMessage" class="notice" role="status"></div>
    </div>

    <div class="home-grid">
      <div class="panel">
        <h2>Create a room</h2>
        <p class="muted smalltext">Choose the time control for both players.</p>
        <div class="field">
          <label for="timeControl">Time control</label>
          <select id="timeControl">
            <option value="1|0">Bullet — 1 minute</option>
            <option value="2|1">Bullet — 2 minutes + 1 second</option>
            <option value="3|0">Blitz — 3 minutes</option>
            <option value="3|2">Blitz — 3 minutes + 2 seconds</option>
            <option value="5|0" selected>Blitz — 5 minutes</option>
            <option value="5|3">Blitz — 5 minutes + 3 seconds</option>
            <option value="10|0">Rapid — 10 minutes</option>
            <option value="10|5">Rapid — 10 minutes + 5 seconds</option>
            <option value="15|10">Rapid — 15 minutes + 10 seconds</option>
            <option value="30|0">Classical — 30 minutes</option>
            <option value="custom">Custom</option>
          </select>
        </div>
        <div id="customTime" style="display:none">
          <div class="field">
            <label for="customMinutes">Minutes per player</label>
            <input id="customMinutes" type="number" min="1" max="180" value="5">
          </div>
          <div class="field">
            <label for="customIncrement">Increment per move (seconds)</label>
            <input id="customIncrement" type="number" min="0" max="60" value="0">
          </div>
        </div>
        <button id="hostButton" class="primary" type="button" style="width:100%">Create room</button>
        <div class="notice">You'll play as White. Share your room code with your friend.</div>
      </div>

      <div class="panel">
        <h2>Join a room</h2>
        <p class="muted smalltext">Enter the code your friend shares. The host's time control is selected automatically.</p>
        <div class="field">
          <label for="roomInput">Room code</label>
          <input id="roomInput" maxlength="12" placeholder="e.g. ABCD23" autocomplete="off">
        </div>
        <button id="joinButton" class="primary" type="button" style="width:100%">Join room</button>
        <div class="notice">You'll play as Black. You don't need to choose a time control.</div>
      </div>
    </div>
  </section>

  <section id="gameScreen">
    <div class="game-layout">
      <div class="board-wrap">
        <div class="playerbar">
          <div>
            <div class="player-name" id="blackName">Waiting for opponent…</div>
            <div class="player-color">Black</div>
          </div>
          <div class="clock" id="blackClock">05:00</div>
        </div>
        <div id="board" aria-label="Chess board"></div>
        <div class="playerbar">
          <div>
            <div class="player-name" id="whiteName">White</div>
            <div class="player-color">White</div>
          </div>
          <div class="clock" id="whiteClock">05:00</div>
        </div>
      </div>

      <aside class="sidebar">
        <div class="panel">
          <h2>Game info</h2>
          <div class="smalltext muted">Room code</div>
          <div id="roomCode">------</div>
          <button id="copyCodeButton" class="secondary small" type="button" style="margin-top:10px">Copy code</button>
          <div class="info-row"><span>Your color</span><strong id="myColor">—</strong></div>
          <div class="info-row"><span>Time control</span><strong id="gameMode">—</strong></div>
          <div class="info-row"><span>Game status</span><strong id="gameStatus">Waiting</strong></div>
          <div id="message" role="status"></div>
        </div>

        <div class="panel">
          <h2>Game actions</h2>
          <div class="actions">
            <button id="drawButton" class="secondary small" type="button">Offer draw</button>
            <button id="resignButton" class="danger small" type="button">Resign</button>
            <button id="leaveButton" class="secondary small" type="button">Leave match</button>
          </div>
          <div id="drawActions" class="actions" style="display:none">
            <button id="acceptDrawButton" class="primary small" type="button">Accept draw</button>
            <button id="declineDrawButton" class="secondary small" type="button">Decline</button>
          </div>
        </div>

        <div class="panel">
          <h2>Moves</h2>
          <div id="moveList">No moves yet.</div>
        </div>
      </aside>
    </div>
  </section>
</main>

<div id="resultOverlay">
  <div class="result-card">
    <div class="result-icon" id="resultIcon">♔</div>
    <h2 id="resultTitle">Game over</h2>
    <p id="resultText" class="muted">The game has ended.</p>
    <button id="resultHomeButton" class="primary" type="button">Back to home</button>
  </div>
</div>

<script>
const firebaseConfig = {
  apiKey: "AIzaSyB1BgVw_108l_IF7aBYtSGG4ktQqIrK4s",
  authDomain: "checkmate-ab589.firebaseapp.com",
  databaseURL: "https://checkmate-ab589-default-rtdb.firebaseio.com",
  projectId: "checkmate-ab589",
  storageBucket: "checkmate-ab589.firebasestorage.app",
  messagingSenderId: "715857675477",
  appId: "1:715857675477:web:779b2e06ca609a00088e5c",
  measurementId: "G-7HETGCWJTF"
};

firebase.initializeApp(firebaseConfig);

const auth = firebase.auth();
const db = firebase.database();
const $ = id => document.getElementById(id);

const chess = new Chess();

let playerId = null;
let roomRef = null;
let roomCode = null;
let roomData = null;
let myColor = null;
let selectedSquare = null;
let legalTargets = [];
let lastMove = null;
let busy = false;
let lastResultShown = null;
let clockInterval = null;

const PIECES = {
  w:{k:"♔",q:"♕",r:"♖",b:"♗",n:"♘",p:"♙"},
  b:{k:"♚",q:"♛",r:"♜",b:"♝",n:"♞",p:"♟"}
};

function setHomeMessage(message, error=false) {
  $("homeMessage").textContent = message || "";
  $("homeMessage").className = "notice " + (error ? "error" : "");
}

function setMessage(message, error=false) {
  $("message").textContent = message || "";
  $("message").className = error ? "error" : "";
}

function normalizedCode(value) {
  return String(value || "").toUpperCase().replace(/[^A-Z0-9]/g,"");
}

function safeName() {
  return $("username").value.trim().replace(/\s+/g," ").slice(0,20);
}

function validName() {
  if (!safeName()) {
    setHomeMessage("Enter your display name first.",true);
    $("username").focus();
    return false;
  }
  return true;
}

function setBusy(value) {
  busy = value;
  $("hostButton").disabled = value;
  $("joinButton").disabled = value;
  $("hostButton").textContent = value ? "Please wait…" : "Create room";
  $("joinButton").textContent = value ? "Please wait…" : "Join room";
}

function getHostTimeControl() {
  if ($("timeControl").value === "custom") {
    const minutes = Number($("customMinutes").value);
    const increment = Number($("customIncrement").value);

    if (!Number.isInteger(minutes) || minutes < 1 || minutes > 180 ||
        !Number.isInteger(increment) || increment < 0 || increment > 60) {
      setHomeMessage("Enter a valid custom time control.",true);
      return null;
    }

    return {
      seconds:minutes*60,
      increment,
      label:`${minutes} min + ${increment}s`
    };
  }

  const parts = $("timeControl").value.split("|").map(Number);
  if (parts.length !== 2 || parts.some(n => !Number.isFinite(n))) {
    setHomeMessage("Choose a valid time control.",true);
    return null;
  }

  return {
    seconds:parts[0]*60,
    increment:parts[1],
    label:parts[1] ? `${parts[0]} min + ${parts[1]}s` : `${parts[0]} min`
  };
}

$("timeControl").addEventListener("change",() => {
  $("customTime").style.display = $("timeControl").value === "custom" ? "block" : "none";
});

function makeCode() {
  const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  let code = "";
  for (let i=0;i<6;i++) code += chars[Math.floor(Math.random()*chars.length)];
  return code;
}

function showGame() {
  $("homeScreen").style.display = "none";
  $("gameScreen").style.display = "block";
  window.scrollTo({top:0,behavior:"smooth"});
}

function showHome() {
  $("gameScreen").style.display = "none";
  $("homeScreen").style.display = "block";
  $("resultOverlay").style.display = "none";
  window.scrollTo({top:0,behavior:"smooth"});
}

function attachRoomListener() {
  if (!roomRef) return;
  roomRef.off("value");

  roomRef.on("value",snapshot => {
    if (!snapshot.exists()) {
      setMessage("This room no longer exists.",true);
      return;
    }

    roomData = snapshot.val();
    roomCode = roomData.code || roomRef.key || roomCode;
    syncRoom(roomData);
  },error => {
    console.error("[Checkmate] Room listener failed:",error);
    setMessage("Couldn't sync the room. Check Firebase database rules.",true);
  });
}

async function hostGame() {
  if (busy || !validName()) return;

  const timeControl = getHostTimeControl();
  if (!timeControl) return;

  if (!playerId) {
    setHomeMessage("Firebase sign-in is not ready. Wait a moment and try again.",true);
    return;
  }

  setBusy(true);
  setHomeMessage("Creating room…");

  try {
    let createdCode = null;
    let createdRef = null;

    for (let attempt=0;attempt<5;attempt++) {
      const candidateCode = makeCode();
      const candidateRef = db.ref("rooms/" + candidateCode);

      const result = await candidateRef.transaction(current => {
        if (current !== null) return;
        return {
          code:candidateCode,
          status:"waiting",
          createdAt:firebase.database.ServerValue.TIMESTAMP,
          players:{w:{id:playerId,name:safeName()}},
          timeControl,
          fen:new Chess().fen(),
          history:[],
          clocks:{w:timeControl.seconds,b:timeControl.seconds},
          turnStartedAt:null,
          lastMove:null,
          drawOffer:null,
          resultType:null,
          winnerId:null,
          resultText:null
        };
      });

      if (result.committed) {
        createdCode = candidateCode;
        createdRef = candidateRef;
        break;
      }
    }

    if (!createdRef) throw new Error("Couldn't create a room. Please try again.");

    roomRef = createdRef;
    roomCode = createdCode;
    myColor = "w";
    lastResultShown = null;

    attachRoomListener();
    showGame();
    setHomeMessage("");
    setMessage("Room created. Share the code with your friend.");
    console.log("[Checkmate] Room created:",roomRef.toString());
  } catch (error) {
    console.error("[Checkmate] Room creation failed:",error);
    setHomeMessage(error.message || "Could not create the room.",true);
  } finally {
    setBusy(false);
  }
}

/*
  Room lookup checks the exact expected path first. This is important
  because Firebase rules may permit reading one room without permitting
  reading the entire /rooms collection.
*/
async function findRoomByCode(code) {
  console.log("[Checkmate] Requested code:",JSON.stringify(code));
  console.log("[Checkmate] Database root:",db.ref().toString());

  const exactRef = db.ref("rooms/" + code);

  try {
    const exactSnapshot = await exactRef.once("value");

    if (exactSnapshot.exists()) {
      console.log("[Checkmate] Exact room found:",exactRef.toString());
      return {ref:exactRef,data:exactSnapshot.val()};
    }
  } catch (error) {
    console.error("[Checkmate] Exact room read failed:",error);
    throw new Error(
      "Firebase denied access to this room. Check Realtime Database rules and anonymous authentication."
    );
  }

  // Try a case-insensitive search if collection-level reading is allowed.
  try {
    const allRooms = await db.ref("rooms").once("value");

    if (allRooms.exists()) {
      const rooms = allRooms.val() || {};
      const matchingKey = Object.keys(rooms).find(
        key => normalizedCode(key) === code
      );

      if (matchingKey) {
        const matchingRef = db.ref("rooms/" + matchingKey);
        console.log("[Checkmate] Matching room found:",matchingRef.toString());
        return {ref:matchingRef,data:rooms[matchingKey]};
      }
    }
  } catch (error) {
    console.warn("[Checkmate] Collection scan unavailable:",error);
  }

  // Check the root as a compatibility fallback for older room records.
  try {
    const legacyRef = db.ref(code);
    const legacySnapshot = await legacyRef.once("value");

    if (legacySnapshot.exists()) {
      const data = legacySnapshot.val();
      if (data && data.players && data.status) {
        console.log("[Checkmate] Legacy root-level room found:",legacyRef.toString());
        return {ref:legacyRef,data};
      }
    }
  } catch (error) {
    console.warn("[Checkmate] Root fallback unavailable:",error);
  }

  console.warn("[Checkmate] No room found at:",exactRef.toString());
  return null;
}

async function joinGame() {
  if (busy || !validName()) return;

  const code = normalizedCode($("roomInput").value);

  if (!/^[A-Z0-9]{6}$/.test(code)) {
    setHomeMessage("Enter the six-character room code shown by the host.",true);
    $("roomInput").focus();
    return;
  }

  if (!playerId) {
    setHomeMessage("Firebase sign-in is not ready. Wait a moment and try again.",true);
    return;
  }

  setBusy(true);
  setHomeMessage("Looking for room " + code + "…");

  try {
    const found = await findRoomByCode(code);

    if (!found) {
      throw new Error(
        "Room not found. Check the code and make sure the host created it in this Checkmate app."
      );
    }

    const candidateRef = found.ref;
    let failureReason = "";

    const claim = await candidateRef.transaction(current => {
      failureReason = "";

      if (!current) {
        failureReason = "The room no longer exists.";
        return;
      }

      if (!current.players || !current.players.w) {
        failureReason = "This room has no valid host. Ask the host to create a new room.";
        return;
      }

      if (current.players.w.id === playerId ||
          current.players.b?.id === playerId) {
        failureReason = "You're already a player in this room in this browser session.";
        return;
      }

      if (current.status !== "waiting" || current.players.b) {
        failureReason = "This room is full or the game has already started.";
        return;
      }

      if (!current.timeControl || !Number(current.timeControl.seconds)) {
        failureReason = "This room has no valid time control. Ask the host to create a new room.";
        return;
      }

      current.players.b = {id:playerId,name:safeName()};
      current.status = "playing";
      current.turnStartedAt = Date.now();

      current.clocks = current.clocks || {
        w:current.timeControl.seconds,
        b:current.timeControl.seconds
      };

      return current;
    });

    if (!claim.committed) {
      const fresh = await candidateRef.once("value");
      const latest = fresh.val();

      if (latest?.players?.w?.id === playerId ||
          latest?.players?.b?.id === playerId) {
        failureReason = "You're already a player in this room in this browser session.";
      } else if (latest && (latest.status !== "waiting" || latest.players?.b)) {
        failureReason = "This room is full or the game has already started.";
      }

      throw new Error(failureReason || "Could not join the room. Check your Firebase rules.");
    }

    roomRef = candidateRef;
    roomCode = candidateRef.key;
    myColor = "b";
    lastResultShown = null;

    attachRoomListener();
    showGame();
    setHomeMessage("");
    setMessage("Joined successfully. You're playing as Black.");

    console.log("[Checkmate] Joined room:",roomRef.toString());
  } catch (error) {
    console.error("[Checkmate] Join failed:",error);
    setHomeMessage(error.message || "Couldn't join the room.",true);
  } finally {
    setBusy(false);
  }
}

function syncRoom(data) {
  try {
    if (data.fen) chess.load(data.fen);
  } catch (error) {
    console.error("[Checkmate] Invalid board position:",error);
    setMessage("The room contains an invalid chess position.",true);
    return;
  }

  lastMove = data.lastMove || null;

  $("roomCode").textContent = roomCode || data.code || "------";
  $("myColor").textContent = myColor === "w" ? "White" : "Black";
  $("whiteName").textContent = data.players?.w?.name || "White";
  $("blackName").textContent = data.players?.b?.name || "Waiting for opponent…";

  const mode = data.timeControl || {seconds:300,increment:0,label:"5 min"};
  $("gameMode").textContent = mode.label ||
    `${Math.floor((mode.seconds || 300)/60)} min${mode.increment ? " + "+mode.increment+"s" : ""}`;

  if (data.status === "waiting") {
    $("gameStatus").textContent = "Waiting for opponent";
  } else if (data.status === "playing") {
    $("gameStatus").textContent = chess.turn() === "w" ? "White to move" : "Black to move";
  } else {
    $("gameStatus").textContent = "Game finished";
  }

  renderBoard();
  renderMoves(data.history || []);
  updateClocks();
  updateDrawActions(data);

  if (data.status === "finished" || data.status === "aborted") {
    showResult(data);
  }
}

function renderBoard() {
  const element = $("board");
  element.innerHTML = "";

  const matrix = chess.board();
  const rows = myColor === "b" ? [7,6,5,4,3,2,1,0] : [0,1,2,3,4,5,6,7];
  const cols = myColor === "b" ? [7,6,5,4,3,2,1,0] : [0,1,2,3,4,5,6,7];

  let checkSquare = null;
  if (chess.in_check()) {
    for (let r=0;r<8;r++) {
      for (let c=0;c<8;c++) {
        const p = matrix[r][c];
        if (p && p.type === "k" && p.color === chess.turn()) {
          checkSquare = String.fromCharCode(97+c) + (8-r);
        }
      }
    }
  }

  for (const r of rows) {
    for (const c of cols) {
      const name = String.fromCharCode(97+c) + (8-r);
      const piece = matrix[r][c];
      const square = document.createElement("button");

      square.type = "button";
      square.className = "square " + ((r+c)%2===0 ? "light" : "dark");
      square.setAttribute("aria-label",name);

      if (selectedSquare === name) square.classList.add("selected");
      if (lastMove && (lastMove.from === name || lastMove.to === name)) {
        square.classList.add("lastmove");
      }
      if (checkSquare === name) square.classList.add("check");

      if (piece) {
        const span = document.createElement("span");
        span.className = "piece " + (piece.color === "w" ? "white" : "black");
        span.textContent = PIECES[piece.color][piece.type];
        square.appendChild(span);
      }

      if (legalTargets.includes(name)) {
        const marker = document.createElement("span");
        marker.className = piece ? "capture-dot" : "legal-dot";
        square.appendChild(marker);
      }

      if ((myColor === "b" && r === 0) || (myColor !== "b" && r === 7)) {
        const label = document.createElement("span");
        label.className = "file-label";
        label.textContent = name[0];
        square.appendChild(label);
      }

      if ((myColor === "b" && c === 7) || (myColor !== "b" && c === 0)) {
        const label = document.createElement("span");
        label.className = "rank-label";
        label.textContent = name[1];
        square.appendChild(label);
      }

      square.addEventListener("click",() => handleSquareClick(name));
      element.appendChild(square);
    }
  }
}

function canMove() {
  return !!roomData &&
    roomData.status === "playing" &&
    !!myColor &&
    chess.turn() === myColor &&
    roomData.players?.[myColor]?.id === playerId;
}

function handleSquareClick(square) {
  if (!canMove() || busy) return;

  const piece = chess.get(square);

  if (selectedSquare && legalTargets.includes(square)) {
    sendMove(selectedSquare,square);
    return;
  }

  if (piece && piece.color === myColor) {
    selectedSquare = square;
    legalTargets = chess.moves({square,verbose:true}).map(move => move.to);
  } else {
    selectedSquare = null;
    legalTargets = [];
  }

  renderBoard();
}

function currentClocks() {
  const mode = roomData?.timeControl || {seconds:300};
  const source = roomData?.clocks || {
    w:mode.seconds || 300,
    b:mode.seconds || 300
  };

  const clocks = {w:Number(source.w),b:Number(source.b)};

  if (roomData?.status === "playing" && roomData.turnStartedAt) {
    const elapsed = Math.max(0,(Date.now()-Number(roomData.turnStartedAt))/1000);
    const turn = chess.turn();
    clocks[turn] = Math.max(0,clocks[turn]-elapsed);
  }

  return clocks;
}

async function sendMove(from,to) {
  if (!canMove() || !roomRef || busy) return;

  const color = myColor;
  const clocks = currentClocks();

  if (clocks[color] <= 0) {
    await finishOnTime(color);
    return;
  }

  const move = chess.move({from,to,promotion:"q"});

  if (!move) {
    selectedSquare = null;
    legalTargets = [];
    renderBoard();
    return;
  }

  selectedSquare = null;
  legalTargets = [];

  clocks[color] += Number(roomData.timeControl?.increment || 0);

  const history = Array.isArray(roomData.history) ? roomData.history.slice() : [];
  history.push({
    color:move.color,
    from:move.from,
    to:move.to,
    san:move.san,
    piece:move.piece,
    captured:move.captured || null,
    promotion:move.promotion || null
  });

  let status = "playing";
  let resultType = null;
  let winnerId = null;
  let resultText = null;

  if (chess.in_checkmate()) {
    status = "finished";
    resultType = "win";
    winnerId = roomData.players[color].id;
    resultText = `${roomData.players[color].name} wins by checkmate!`;
  } else if (chess.in_stalemate() || chess.in_draw()) {
    status = "finished";
    resultType = "draw";
    resultText = chess.in_stalemate() ? "Draw by stalemate." : "The game is a draw.";
  }

  busy = true;

  try {
    await roomRef.update({
      fen:chess.fen(),
      history,
      clocks,
      lastMove:{from,to},
      turnStartedAt:status === "playing" ? Date.now() : null,
      status,
      drawOffer:null,
      resultType,
      winnerId,
      resultText
    });
  } catch (error) {
    console.error("[Checkmate] Move sync failed:",error);
    if (roomData?.fen) chess.load(roomData.fen);
    setMessage("Your move could not be saved. Check your connection and try again.",true);
  } finally {
    busy = false;
    renderBoard();
  }
}

function formatClock(seconds) {
  seconds = Math.max(0,Math.ceil(seconds || 0));
  return `${String(Math.floor(seconds/60)).padStart(2,"0")}:${String(seconds%60).padStart(2,"0")}`;
}

function updateClocks() {
  if (!roomData) return;

  const clocks = currentClocks();

  for (const color of ["w","b"]) {
    const el = color === "w" ? $("whiteClock") : $("blackClock");
    el.textContent = formatClock(clocks[color]);
    el.classList.toggle("active",roomData.status === "playing" && chess.turn() === color);
    el.classList.toggle("low",clocks[color] <= 10);
  }

  if (roomData.status === "playing" &&
      clocks[chess.turn()] <= 0 &&
      roomData.players?.[myColor]?.id === playerId) {
    finishOnTime(chess.turn());
  }
}

async function finishOnTime(flaggedColor) {
  if (!roomRef || !roomData || roomData.status !== "playing") return;
  if (roomData.players?.[myColor]?.id !== playerId) return;

  const winnerColor = flaggedColor === "w" ? "b" : "w";
  const winner = roomData.players?.[winnerColor];

  try {
    await roomRef.transaction(current => {
      if (!current || current.status !== "playing") return;
      current.status = "finished";
      current.resultType = "win";
      current.winnerId = winner?.id || null;
      current.resultText = `${winner?.name || winnerColor.toUpperCase()} wins on time.`;
      current.turnStartedAt = null;
      current.drawOffer = null;
      return current;
    });
  } catch (error) {
    console.error("[Checkmate] Timeout result failed:",error);
  }
}

function renderMoves(history) {
  if (!history.length) {
    $("moveList").textContent = "No moves yet.";
    return;
  }

  const lines = [];
  for (let i=0;i<history.length;i+=2) {
    const number = Math.floor(i/2)+1;
    lines.push(`${number}. ${history[i]?.san || ""}${history[i+1]?.san ? "   "+history[i+1].san : ""}`);
  }

  $("moveList").textContent = lines.join("\n");
  $("moveList").scrollTop = $("moveList").scrollHeight;
}

function updateDrawActions(data) {
  const offer = data.drawOffer;
  $("drawActions").style.display =
    offer && offer.id !== playerId && data.status === "playing" ? "flex" : "none";

  if (offer && offer.id !== playerId && data.status === "playing") {
    setMessage(`${offer.name || "Your opponent"} offered a draw.`);
  } else if (offer && offer.id === playerId && data.status === "playing") {
    setMessage("Draw offered. Waiting for your opponent.");
  }
}

async function offerDraw() {
  if (!roomRef || !roomData || roomData.status !== "playing") {
    setMessage("There is no active game.",true);
    return;
  }

  try {
    await roomRef.update({drawOffer:{id:playerId,name:safeName()}});
  } catch (error) {
    setMessage("Couldn't send the draw offer.",true);
  }
}

async function acceptDraw() {
  if (!roomRef || !roomData || !roomData.drawOffer ||
      roomData.drawOffer.id === playerId) return;

  try {
    await roomRef.transaction(current => {
      if (!current || current.status !== "playing" ||
          !current.drawOffer || current.drawOffer.id === playerId) return;

      current.status = "finished";
      current.resultType = "draw";
      current.resultText = "The players agreed to a draw.";
      current.winnerId = null;
      current.turnStartedAt = null;
      current.drawOffer = null;
      return current;
    });
  } catch (error) {
    setMessage("Couldn't accept the draw.",true);
  }
}

async function declineDraw() {
  if (!roomRef) return;
  try {
    await roomRef.update({drawOffer:null});
  } catch (error) {
    setMessage("Couldn't decline the draw.",true);
  }
}

async function finishForfeit(reason) {
  if (!roomRef || !roomData || roomData.status !== "playing") return;

  const opponentColor = myColor === "w" ? "b" : "w";
  const opponent = roomData.players?.[opponentColor];

  try {
    await roomRef.transaction(current => {
      if (!current || current.status !== "playing") return;

      current.status = "finished";
      current.resultType = "win";
      current.winnerId = opponent?.id || null;
      current.resultText = reason === "resign"
        ? `${current.players?.[myColor]?.name || "A player"} resigned. ${opponent?.name || "The opponent"} wins!`
        : `${current.players?.[myColor]?.name || "A player"} left the game. ${opponent?.name || "The opponent"} wins!`;

      current.turnStartedAt = null;
      current.drawOffer = null;
      return current;
    });
  } catch (error) {
    console.error("[Checkmate] Forfeit failed:",error);
    setMessage("Couldn't submit the result.",true);
  }
}

async function resignGame() {
  if (!roomData || roomData.status !== "playing") return;
  if (!confirm("Are you sure you want to resign?")) return;
  await finishForfeit("resign");
}

async function leaveMatch() {
  if (!roomRef || !roomData) {
    resetToHome();
    return;
  }

  if (roomData.status === "playing") {
    if ((roomData.history || []).length > 0) {
      if (!confirm("Leaving now will count as a resignation. Continue?")) return;
      await finishForfeit("leave");
    } else {
      try {
        await roomRef.update({
          status:"aborted",
          resultType:"aborted",
          resultText:"The game was closed before the first move.",
          turnStartedAt:null
        });
      } catch (error) {
        console.error("[Checkmate] Could not close game:",error);
      }
    }
  } else if (roomData.status === "waiting") {
    try {
      await roomRef.update({
        status:"aborted",
        resultType:"aborted",
        resultText:"The host closed this room.",
        turnStartedAt:null
      });
    } catch (error) {
      console.error("[Checkmate] Could not close room:",error);
    }
  }

  resetToHome();
}

function showResult(data) {
  const key = `${roomCode || ""}:${data.resultText || ""}:${data.resultType || ""}`;
  if (lastResultShown === key) return;
  lastResultShown = key;

  $("resultText").textContent = data.resultText || "The game has ended.";

  if (data.resultType === "draw") {
    $("resultIcon").textContent = "🤝";
    $("resultTitle").textContent = "Draw!";
  } else if (data.resultType === "aborted") {
    $("resultIcon").textContent = "♟";
    $("resultTitle").textContent = "Room closed";
  } else {
    const won = data.winnerId && data.winnerId === playerId;
    $("resultIcon").textContent = won ? "🏆" : "♟";
    $("resultTitle").textContent = won ? "You won!" : "Game over";
  }

  $("resultOverlay").style.display = "flex";
}

function resetToHome() {
  if (roomRef) roomRef.off("value");

  roomRef = null;
  roomCode = null;
  roomData = null;
  myColor = null;
  selectedSquare = null;
  legalTargets = [];
  lastMove = null;
  lastResultShown = null;

  chess.reset();

  $("resultOverlay").style.display = "none";
  $("roomInput").value = "";
  $("roomCode").textContent = "------";
  $("moveList").textContent = "No moves yet.";
  setMessage("");
  setHomeMessage("");
  showHome();
}

async function copyRoomCode() {
  if (!roomCode) return;

  try {
    await navigator.clipboard.writeText(roomCode);
    setMessage("Room code copied.");
  } catch (error) {
    setMessage("Your room code is " + roomCode + ". Copy it manually.");
  }
}

$("hostButton").addEventListener("click",hostGame);
$("joinButton").addEventListener("click",joinGame);
$("copyCodeButton").addEventListener("click",copyRoomCode);
$("drawButton").addEventListener("click",offerDraw);
$("acceptDrawButton").addEventListener("click",acceptDraw);
$("declineDrawButton").addEventListener("click",declineDraw);
$("resignButton").addEventListener("click",resignGame);
$("leaveButton").addEventListener("click",leaveMatch);
$("resultHomeButton").addEventListener("click",resetToHome);

$("roomInput").addEventListener("keydown",event => {
  if (event.key === "Enter") joinGame();
});

auth.signInAnonymously().then(credential => {
  playerId = credential.user.uid;
  $("connectionStatus").textContent = "Connected";
  $("connectionStatus").className = "smalltext success";
}).catch(error => {
  console.error("[Checkmate] Anonymous authentication failed:",error);
  $("connectionStatus").textContent = "Sign-in failed";
  $("connectionStatus").className = "smalltext error";
  setHomeMessage("Firebase anonymous sign-in failed. Enable Anonymous sign-in in Firebase Authentication.",true);
});

db.ref(".info/connected").on("value",snapshot => {
  const connected = snapshot.val() === true;
  $("connectionStatus").textContent = connected ? "Connected" : "Reconnecting…";
  $("connectionStatus").className = "smalltext " + (connected ? "success" : "muted");
});

clockInterval = setInterval(updateClocks,250);
</script>
</body>
</html>
